HERE=$(dirname "$(readlink -f -- "$0")")

# The main executable links to ./lib through an $ORIGIN rpath, so this is only
# a safety net for shells or launchers that sanitize the environment.
export LD_LIBRARY_PATH="$HERE/usr/bin/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

exec "$HERE/usr/bin/convertall" "$@"
